location  = "Central India"
name_prefix = "akscrud"
environment = "dev"

vnet_address_space = [
  "10.20.0.0/16"
]

aks_subnet_address_prefix = "10.20.1.0/24"

application_gateway_subnet_address_prefix = "10.20.2.0/24"

private_endpoint_subnet_address_prefix = "10.20.3.0/24"

# Must be an unused address in the AKS subnet.
aks_service_private_ip = "10.20.1.50"

aks_system_node_count = 2
aks_user_node_count   = 2

aks_vm_size = "Standard_B2s"

aks_admin_username = "azureadmin"

# Replace this with your SSH public key.
aks_ssh_public_key = "ssh-rsa YOUR_PUBLIC_KEY_HERE"

sql_admin_username = "sqladmin"

# DO NOT COMMIT THE REAL PASSWORD.
sql_admin_password = "REPLACE_WITH_STRONG_PASSWORD"

sql_database_name = "CrudApiDb"

sql_sku_name = "Basic"

tags = {
  Owner = "DevOps"
}
